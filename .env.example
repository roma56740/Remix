# -----------------------------
# Website and session
# -----------------------------
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
COOKIE_HTTPS_ONLY=false
ADMIN_EMAILS=admin@example.com
SITE_URL=http://127.0.0.1:8000
HOST=0.0.0.0
PORT=8000
APP_RELOAD=false

# -----------------------------
# Telegram bot
# Create the bot in @BotFather
# -----------------------------
BOT_ENABLED=true
BOT_TOKEN=
BOT_USERNAME=ramixmusicbot
ADMIN_TELEGRAM_IDS=
TELEGRAM_POLLING_TIMEOUT=30
TELEGRAM_OUTBOX_INTERVAL=3
TELEGRAM_AUTH_TTL_MINUTES=15
MIN_PAYOUT_RUB=1000

# -----------------------------
# Persistent storage
# Local defaults can stay unchanged.
# On Railway mount a Volume to /data and set DATA_DIR=/data
# -----------------------------
DATA_DIR=./data
# DATABASE_PATH=/data/ramix_music.sqlite3
# UPLOAD_ROOT=/data/uploads
# IMPORT_DIR=/data/imports
